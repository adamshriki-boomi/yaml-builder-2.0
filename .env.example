# Frontend env for the AI chat agent.
# Copy this file to `.env.local` (which is gitignored) and fill in the values.

# URL of the Supabase Edge Function proxy (see supabase/functions/chat-proxy):
#   local:  http://localhost:54321/functions/v1/chat-proxy
#   prod:   https://<your-project-ref>.supabase.co/functions/v1/chat-proxy
VITE_SUPABASE_FUNCTION_URL=

# Supabase anon (public) key — safe to expose in the client bundle.
# Found in: Supabase dashboard → Project Settings → API → Project API keys → anon public.
VITE_SUPABASE_ANON_KEY=
