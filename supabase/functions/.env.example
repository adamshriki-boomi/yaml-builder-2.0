# Server-side secrets for the chat-proxy Edge Function.
# These NEVER reach the browser — they live only in the function's runtime.
#
# Local dev: copy this file to `supabase/functions/.env` (gitignored) and run:
#   supabase functions serve chat-proxy --env-file supabase/functions/.env
#
# Production: set them as secrets instead of committing:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# Required — your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional overrides.
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=8192
